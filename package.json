{
  "name": "flight-control",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Flight Control V2: an operational roster app for airline crew (static frontend).",
  "type": "module",
  "engines": {
    "node": ">=21"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "serve": "python3 scripts/dev-server.py 8080",
    "build:offline": "node scripts/build-offline.mjs",
    "check:offline": "node scripts/build-offline.mjs --check",
    "build": "npm run build:offline",
    "check": "npm run check:offline"
  }
}
